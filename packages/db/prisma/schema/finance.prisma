model PayCheck {
    id        Int          @id @default(autoincrement())
    amount    Int
    comment   String
    date      String
    type      PayCheckType @default(SALARY)
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    // Relations
    organizationId Int
    userId         Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user           User         @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([organizationId])
}

model ManagerSalary {
    id            Int       @id @default(autoincrement())
    monthlyAmount Int
    startDate     String
    endDate       String?
    comment       String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // Relations
    organizationId Int
    userId         Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([organizationId])
}

model Rate {
    id              Int      @id @default(autoincrement())
    name            String
    bid             Int
    bonusPerStudent Int      @default(0)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    // Relations
    organizationId Int
    organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    teacherGroups  TeacherGroup[]
    groupTypes     GroupType[]

    @@index([organizationId])
}

/// Деньги: сколько получено — или ожидается — и чем. Уроки живут в `Package`, и
/// оплата про них ничего не знает: очередь списания от платежей не зависит вовсе.
///
/// Сущность техническая: сюда со временем приедет стык с платёжным провайдером —
/// внешний id, ссылка на оплату, частичные поступления.
model Payment {
    id        Int      @id @default(autoincrement())
    price     Int      @default(0)
    date      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    /// `PENDING` — счёт выставлен, денег ещё нет, и пакеты под ним не выданы.
    /// `ACTIVE` — оплачена. Отменённая не удаляется: на её пакеты ссылаются проводки
    /// проведённых занятий, и стереть её значило бы переписать прошлые месяцы.
    status PaymentStatus @default(ACTIVE)
    /// Когда отменили — чтобы в списке было видно, что это не свежая запись.
    cancelledAt DateTime?

    /// Id счёта в amoCRM. Опрос идёт скользящим окном, поэтому один и тот же
    /// оплаченный счёт видно тысячу раз за неделю: эта колонка — единственное,
    /// что отличает «уже завели» от «завести». Заполнена только у оплат, которые
    /// приехали из CRM.
    externalId Int?

    // Relations
    //
    // Счёт обезличен: ни ученика, ни продавца на нём нет. И тот и другой относятся
    // к продаже, то есть к пакету, а один счёт может закрыть пакеты разных учеников
    // — «чей платёж» выводится через `packages`.
    organizationId  Int
    paymentMethodId Int?
    organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

    /// Один счёт может закрыть несколько пакетов — например, двоих детей сразу.
    packages Package[]

    @@index([organizationId])
    @@index([createdAt])
    @@index([paymentMethodId])
    /// Список оплат школы: выборка по периоду плюс сортировка по дате по умолчанию.
    /// Отдельного `organizationId` для этого мало — по нему пришлось бы отбирать все
    /// оплаты школы и сортировать их каждый раз заново.
    @@index([organizationId, date])
    /// Аккаунт CRM у каждой школы свой, и номера счетов в разных аккаунтах
    /// совпадают свободно — отсюда пара, а не один `externalId`.
    @@unique([organizationId, externalId])
}

/// Пакет уроков: то, что продаёт менеджер и что гасят посещения. Встаёт в очередь
/// кошелька по `date` и тратится с головы, пока не кончится `remaining`.
///
/// Уроки зачисляются не при создании, а при подтверждении оплаты: до него пакет
/// `PENDING` — в очередь не встаёт и баланса не двигает. Занятия, проведённые за это
/// время, ждут оплаты и списываются в момент подтверждения, по цене этого пакета.
///
/// `paymentId` пустой — денег под пакетом нет вовсе: подарок, компенсация или
/// корректировка, которой бэкфилл сводил остаток кошелька с его балансом.
model Package {
    id          Int           @id @default(autoincrement())
    lessonCount Int
    /// Сколько уроков ещё не потрачено. `Σ WalletEntry.quantity` по пакету.
    remaining   Int
    /// Сколько стоит сам пакет. Хранится, а не выводится из `unitPrice × lessonCount`:
    /// деление даёт остаток (1000 ₽ за 3 занятия), и на нём разъехались бы суммы
    /// поступлений. У подарочного пакета — ноль.
    price       Int           @default(0)
    /// Цена урока этого пакета. Копируется в проводку посещения и дальше не
    /// пересчитывается, поэтому новые оплаты не двигают закрытые месяцы.
    unitPrice   Int           @default(0)
    /// Бизнес-день: по нему строится очередь списания.
    date        String
    status      PackageStatus @default(PENDING)
    cancelledAt DateTime?
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    // Relations
    organizationId Int
    studentId      Int
    walletId       Int
    paymentId      Int?
    productId      Int?
    /// Кто продал. Не автор записи: счёт часто заводит один администратор за всех,
    /// а премия причитается тому, кто договорился. Живёт на пакете, а не на счёте:
    /// продажа — это пакет, и премия считается за проданный продукт. Поле
    /// необязательное — у пакетов до его появления продавца нет.
    managerId      Int?
    /// Снимок названия продукта на момент продажи: продукт можно переименовать или
    /// удалить, а подпись проданного пакета обязана остаться прежней.
    productName    String @default("")

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    student      Student      @relation(fields: [studentId], references: [id])
    wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
    payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
    product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
    manager      User?        @relation(fields: [managerId], references: [id], onDelete: SetNull)

    attendances Attendance[]
    ledger      WalletEntry[]

    /// Очередь списания: пакеты кошелька по дате.
    @@index([walletId, date])
    @@index([organizationId, date])
    @@index([paymentId])
    @@index([productId])
    @@index([studentId])
    @@index([managerId])
}

/// Журнал движений кошелька: одна строка на каждое изменение остатка уроков.
///
/// Строки не правятся и не удаляются — ошибка исправляется встречной строкой.
/// Поэтому по журналу можно восстановить, каким остаток был на любой момент, и
/// увидеть, кто и когда его подвинул.
///
/// Две суммы держат всю денежную модель:
///   Σ quantity по кошельку   = Wallet.lessonsBalance
///   Σ quantity по пакету     = Package.remaining
/// Обе колонки — кеш поверх журнала, а не отдельная правда; сходимость проверяет
/// `scripts/check-ledger.ts`.
model WalletEntry {
    id       Int             @id @default(autoincrement())
    kind     WalletEntryKind
    /// Уроки: + пришли, − ушли. Ноль — движения не было, но событие записать надо.
    quantity Int
    /// Цена урока в этой строке; `quantity × unitPrice` — деньги строки.
    unitPrice Int @default(0)

    /// Бизнес-день движения: дата занятия или оплаты, а не дата записи. По нему
    /// строятся отчёты — задним числом внесённое занятие попадает в свой месяц.
    effectiveAt String
    /// Когда строку записали. Пара с `effectiveAt` позволяет спросить «какой была
    /// выручка марта по состоянию на 1 апреля».
    createdAt DateTime @default(now())

    comment String?

    // Relations
    organizationId Int
    walletId       Int
    studentId      Int
    packageId      Int?
    actorUserId    Int?
    /// Какую строку отменяет. У списания отмена может быть только одна: повторное
    /// списание того же занятия — это новая пара строк. Корректировка ссылается на
    /// откат, урок которого вернуть было некуда (пакета нет или он отменён).
    reversalOfId Int? @unique

    organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
    student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
    package      Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
    actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
    reversalOf   WalletEntry?  @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
    reversedBy   WalletEntry?  @relation("LedgerReversal")

    /// Занятие, за которое списали. FK нет намеренно: строку посещаемости удаляют,
    /// а запись о движении денег обязана её пережить.
    attendanceId Int?

    @@index([walletId, effectiveAt])
    @@index([organizationId, effectiveAt])
    @@index([packageId])
    @@index([attendanceId])
    @@index([studentId])
}

model UnprocessedPayment {
    id        Int      @id @default(autoincrement())
    rawData   Json?
    reason    String
    resolved  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    organizationId Int
    studentId      Int?
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    student        Student?     @relation(fields: [studentId], references: [id])

    @@index([organizationId])
    @@index([studentId])
}

/// Продукт — то, что школа продаёт родителю: абонемент на N занятий за такую-то
/// цену. Прайс-лист, из которого собирается оплата. Товар магазина — это
/// `ShopItem`, другая сущность и другие деньги (астрокоины).
model Product {
    id          Int     @id @default(autoincrement())
    name        String
    price       Int
    lessonCount Int
    description String?

    /// Id товара в amoCRM: по нему опрос оплат находит, какой продукт школы
    /// продали. Заполняется руками — из CRM приезжает только id, а сколько за ним
    /// занятий, знает школа. И знает по-своему: «36 занятий с разбивкой на 3
    /// платежа» — это 12 занятий, треть годового абонемента, так что вывести
    /// количество из названия позиции нельзя.
    externalId Int?

    /// Снятый с продажи продукт не удаляют: на него ссылаются проданные пакеты, и в
    /// форме новой оплаты он просто больше не предлагается. Как у `PaymentMethod`.
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    packages       Package[]

    /// Один товар CRM — один продукт школы: иначе оплата не знает, какой из двух
    /// выбрать. NULL уникальность не задевает, поэтому школы без интеграции
    /// ограничение не чувствуют.
    @@unique([organizationId, externalId])
    @@index([organizationId])
}

model PaymentMethod {
    id          Int      @id @default(autoincrement())
    name        String
    commission  Float    @default(0)
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    payments       Payment[]

    @@index([organizationId])
}

model TaxConfig {
    id        Int      @id @default(autoincrement())
    taxSystem String // "USN_INCOME", "OSNO", etc.
    config    Json // System-specific parameters, validated by Zod at app level
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizationId Int          @unique
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
}

model StudentLessonsBalanceHistory {
    id             Int                               @id @default(autoincrement())
    studentId      Int
    organizationId Int
    actorUserId    Int?
    groupId        Int?
    walletId       Int?
    field          StudentFinancialField             @default(LESSONS_BALANCE)
    reason         StudentLessonsBalanceChangeReason
    delta          Int
    balanceBefore  Int
    balanceAfter   Int
    comment        String?
    meta           Json?
    createdAt      DateTime                          @default(now())
    updatedAt      DateTime                          @updatedAt

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
    actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
    group        Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
    wallet       Wallet?      @relation(fields: [walletId], references: [id], onDelete: SetNull)

    @@index([studentId, createdAt])
    @@index([actorUserId, createdAt])
    @@index([organizationId])
    @@index([groupId])
    @@index([walletId])
}

model Expense {
    id        Int      @id @default(autoincrement())
    name      String
    amount    Int
    date      String
    comment   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
}

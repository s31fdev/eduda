// Better-auth models

model User {
    id Int @id @default(autoincrement())

    // better-auth fields
    name          String
    email         String
    emailVerified Boolean   @default(false)
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    role          String?
    banned        Boolean?  @default(false)
    banReason     String?
    banExpires    DateTime?

    groups                TeacherGroup[]
    lessons               TeacherLesson[]
    payChecks             PayCheck[]
    managerSalaries       ManagerSalary[]
    soldPackages          Package[]
    lessonsBalanceChanges StudentLessonsBalanceHistory[]
    ledgerEntries         WalletEntry[]
    statusChanges         StatusChange[]
    sessions              Session[]
    accounts              Account[]
    members               Member[]
    invitations           Invitation[]
    assistantThreads      AssistantThread[]

    @@unique([email])
    @@map("User")
}

model Session {
    id                   Int      @id @default(autoincrement())
    expiresAt            DateTime
    token                String
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt
    ipAddress            String?
    userAgent            String?
    userId               Int
    user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    impersonatedBy       String?
    activeOrganizationId String?

    @@unique([token])
    @@index([userId])
    @@map("Session")
}

model Account {
    id                    Int       @id @default(autoincrement())
    accountId             String
    providerId            String
    userId                Int
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("Account")
}

model Verification {
    id         Int      @id @default(autoincrement())
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("Verification")
}

model Organization {
    id                             Int                            @id @default(autoincrement())
    name                           String
    slug                           String
    logo                           String?
    createdAt                      DateTime                       @default(now())
    updatedAt                      DateTime                       @updatedAt
    metadata                       String?
    timezone                       String                         @default("Europe/Moscow")
    /// Напоминания родителям о занятиях. По умолчанию выключены: рассылка от
    /// имени школы — её решение, а не наше.
    remindersEnabled               Boolean                        @default(false)
    /// Режим отправки. От него зависит, какая из двух колонок ниже что-то
    /// значит: у `DAY_BEFORE` — `reminderTime`, у `SAME_DAY` — `reminderLeadMinutes`.
    /// Вторая колонка при этом не чистится: школа переключает режим туда-сюда,
    /// и терять её настройку при каждом переключении незачем.
    reminderMode                   ReminderMode                   @default(SAME_DAY)
    /// Только для `DAY_BEFORE`: час отправки, `HH:mm` в поясе школы — тот же
    /// формат, что у `Lesson.time`.
    reminderTime                   String                         @default("20:00")
    /// Только для `SAME_DAY`: за сколько минут до начала урока. Крон приходит
    /// раз в десять минут, поэтому точность отправки — около десяти минут.
    reminderLeadMinutes            Int                            @default(120)
    /// Шаблон сообщения с подстановками в фигурных скобках. Рендерит и
    /// проверяет его `@repo/core/reminder-template` — один и тот же код на
    /// платформе (превью) и в ботах (настоящая отправка). Своего текста рендер
    /// не добавляет: что школа написала, то родитель и получит.
    reminderTemplate               String                         @default("{когда}\n\n{занятия}\n\nНе сможете прийти — отметьте в кабинете.\n\nОтключить напоминания — /stop")
    /// Шаблон одной строки занятия — то, что встаёт на место `{занятия}`.
    /// Отдельно от тела, потому что рендерится на КАЖДОЕ занятие: у родителя
    /// двое детей или у ребёнка два урока в день — это две строки в одном
    /// сообщении, и имя с курсом принадлежат строке, а не письму.
    reminderLineTemplate           String                         @default("• {ученик} — {курс}, {время}, {место}")
    members                        Member[]
    invitations                    Invitation[]
    rates                          Rate[]
    groupTypes                     GroupType[]
    courses                        Course[]
    locations                      Location[]
    students                       Student[]
    groups                         Group[]
    payChecks                      PayCheck[]
    studentGroups                  StudentGroup[]
    teacherGroups                  TeacherGroup[]
    teacherLessons                 TeacherLesson[]
    lessons                        Lesson[]
    attendances                    Attendance[]
    payments                       Payment[]
    packages                       Package[]
    unprocessedPayments            UnprocessedPayment[]
    carts                          Cart[]
    cartItems                      CartItem[]
    categories                     Category[]
    shopItems                      ShopItem[]
    orders                         Order[]
    orderItems                     OrderItem[]
    products                       Product[]
    studentLessonsBalanceHistories StudentLessonsBalanceHistory[]
    walletEntries                  WalletEntry[]
    groupSchedules                 GroupSchedule[]
    wallets                        Wallet[]
    parents                        Parent[]
    features                       OrganizationFeature[]
    paymentMethods                 PaymentMethod[]
    taxConfig                      TaxConfig?
    snoozedAlerts                  SnoozedAlert[]
    rents                          Rent[]
    expenses                       Expense[]
    managerSalaries                ManagerSalary[]
    organizationroles              OrganizationRole[]
    assistantThreads               AssistantThread[]
    assistantMessages              AssistantMessage[]
    studentParents                 StudentParent[]
    studentAccounts                StudentAccount[]
    coinTransactions               CoinTransaction[]
    studentAchievements            StudentAchievement[]
    parentMessengers               ParentMessenger[]
    notificationOutbox             NotificationOutbox[]
    statusChanges                  StatusChange[]
    maxBot                         OrganizationMaxBot?

    @@unique([slug])
    @@map("Organization")
}

model OrganizationFeature {
    id             Int          @id @default(autoincrement())
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    featureKey     String
    enabled        Boolean      @default(true)

    @@unique([organizationId, featureKey])
    @@index([organizationId])
    @@map("OrganizationFeature")
}

model Member {
    id             Int          @id @default(autoincrement())
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         Int
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    role           String       @default("teacher")
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt

    @@index([organizationId])
    @@index([userId])
    @@map("Member")
}

model Invitation {
    id             Int          @id @default(autoincrement())
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    email          String
    role           String?
    status         String       @default("pending")
    expiresAt      DateTime
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    inviterId      Int
    user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

    @@index([organizationId])
    @@index([email])
    @@map("Invitation")
}

model OrganizationRole {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  label          String?
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@unique([organizationId, role])
  @@index([organizationId])
  @@index([role])
  @@map("OrganizationRole")
}
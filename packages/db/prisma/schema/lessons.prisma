model Lesson {
    id        Int          @id @default(autoincrement())
    date      String
    time      String
    duration  Int          @default(60)
    status    LessonStatus @default(ACTIVE)
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    organizationId Int
    groupId        Int
    group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    attendance Attendance[]
    teachers   TeacherLesson[]
    statusChanges StatusChange[]

    @@index([groupId])
    @@index([organizationId])
    @@index([date])
}

model TeacherLesson {
    bid             Int
    bonusPerStudent Int      @default(0)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    // Relations
    organizationId Int
    lessonId       Int
    teacherId      Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
    teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

    @@id([teacherId, lessonId])
    @@index([lessonId])
    @@index([organizationId])
}

model Attendance {
    id        Int              @id @default(autoincrement())
    status    AttendanceStatus @default(UNSPECIFIED)
    comment   String           @default("")
    isWarned  Boolean?
    isTrial   Boolean          @default(false)
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt

    // Relations
    organizationId Int
    lessonId       Int
    studentId      Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
    student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

    makeupForAttendanceId Int?        @unique
    makeupForAttendance   Attendance? @relation("MakeupLink", fields: [makeupForAttendanceId], references: [id], onDelete: SetNull)
    makeupAttendance      Attendance? @relation("MakeupLink")

    /// Когда отметку поставил родитель через /cabinet/{token}; null — отметка сотрудника.
    /// «Родитель предупредил» и «преподаватель отметил» выглядят в БД одинаково
    /// (ABSENT + isWarned), но цена ошибки у них разная, поэтому источник храним.
    /// FK на Parent не заводим: вопрос — «из кабинета или из платформы», а не «какой
    /// из двух родителей», и без FK отметка переживает удаление родителя.
    parentMarkedAt DateTime?

    // Кошелёк для списания разового посещения (ученик не состоит в группе урока).
    // null — обычная запись, списание идёт через StudentGroup группы урока.
    walletId Int?
    wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

    /// Проводка: из какого пакета списан урок, по какой цене и сколько уроков.
    /// `price × amount` — признанная выручка строки; после записи она не
    /// пересчитывается, поэтому новые оплаты не двигают прошлые месяцы.
    ///
    /// `amount` — сколько уроков в строке, и это всегда 1: занятие есть занятие,
    /// оплачено оно или нет. Признак «за это уже заплатили» живёт на `price`:
    /// null — цены ещё нет, занятие ждёт оплаты; число — цена застыла в момент
    /// списания. Раньше это кодировалось нулевым количеством, и из-за этого
    /// «урока не было» и «урок не оплачен» выглядели в базе одинаково.
    packageId Int?
    price     Int?
    amount    Int      @default(1)
    package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

    @@unique([studentId, lessonId])
    @@index([lessonId])
    @@index([organizationId])
    @@index([walletId])
    @@index([packageId])
}

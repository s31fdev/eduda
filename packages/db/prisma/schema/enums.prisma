enum AttendanceStatus {
    UNSPECIFIED
    PRESENT
    ABSENT
}

enum OrderStatus {
    COMPLETED
    PENDING
    CANCELLED
}

enum CoinTxReason {
    ATTENDANCE_PRESENT
    ATTENDANCE_REVERTED
    MANUAL_GRANT
    MANUAL_DEDUCT
    ORDER_PURCHASE
    ORDER_CANCELLED
    INITIAL_BALANCE
    ACHIEVEMENT_CLAIM
}

enum GroupStatus {
    ACTIVE
    ARCHIVED
    COMPLETED
}

enum WalletStatus {
    ACTIVE
    ARCHIVED
}


enum LessonStatus {
    ACTIVE
    CANCELLED
}

enum PaymentStatus {
    /// Счёт выставлен, деньги не подтверждены. Пакеты под ним ждут подтверждения.
    PENDING
    /// Оплачена: деньги получены, пакеты выданы.
    ACTIVE
    CANCELLED
}

enum PackageStatus {
    /// Счёт не подтверждён: пакет в очередь списания не встаёт и баланс не двигает.
    PENDING
    ACTIVE
    CANCELLED
}

enum StudentStatus {
    TRIAL
    ACTIVE
    DISMISSED
    TRANSFERRED
    COMPLETED
    // Запись закрыта вместе с группой: ученик не отчислялся и курс не проходил.
    // Отдельный статус, чтобы архивация не попадала ни в отток, ни в выпускники.
    ARCHIVED
}

enum StudentLessonsBalanceChangeReason {
    PAYMENT_CREATED
    PAYMENT_CANCELLED
    ATTENDANCE_PRESENT_CHARGED
    ATTENDANCE_ABSENT_CHARGED
    MAKEUP_ATTENDED_CHARGED
    ATTENDANCE_REVERTED
    MAKEUP_GRANTED
    MANUAL_SET
    TOTAL_PAYMENTS_MANUAL_SET
    TOTAL_LESSONS_MANUAL_SET
    BALANCE_REDISTRIBUTED
    WALLET_MERGED
    WALLET_TRANSFER
    LESSON_CANCELLED
}

enum WalletEntryKind {
    /// Оплата: уроки пришли в кошелёк.
    PURCHASE
    /// Занятие списано.
    CHARGE
    /// Списание отменено: занятие перестало быть платным или строка удалена.
    REVERSAL
    /// Отмена оплаты: непотраченный остаток пакета снят.
    CANCELLATION
    /// Корректировка: сальдо на момент запуска журнала и разметка истории.
    ADJUSTMENT
    /// Перенос пакета на другой кошелёк: пара строк, минус на источнике и плюс на
    /// получателе. Сумма по пакету не меняется, сумма по кошелькам едет.
    TRANSFER
}

enum StudentFinancialField {
    LESSONS_BALANCE
    TOTAL_PAYMENTS
    TOTAL_LESSONS
}

enum PayCheckType {
    SALARY
    BONUS
    ADVANCE
}

enum MessengerProvider {
    VK
    MAX
}

enum NotificationStatus {
    PENDING
    SENT
    FAILED
}

/// Когда родителю уходит напоминание. Вариантов ровно два, и устроены они
/// по-разному: `DAY_BEFORE` — одно сообщение на день, накануне в назначенный
/// час; `SAME_DAY` — сообщение на каждое время урока, за несколько часов до
/// начала. Второй режим привязан к уроку, а не к дню, поэтому у двух детей с
/// разным расписанием это два разных сообщения.
enum ReminderMode {
    DAY_BEFORE
    SAME_DAY
}

enum StatusEntity {
    STUDENT_GROUP
    LESSON
}

/// Почему статус сменился. Отдельно от пары from/to, потому что статусы этого не
/// говорят: `null → ACTIVE` — это и зачисление, и приход переводом, а
/// `DISMISSED → ACTIVE` — и возврат, и перевод.
enum StatusChangeReason {
    /// Зачислен в группу.
    ENROLLED
    /// Возвращён после отчисления.
    RETURNED
    /// Переведён отсюда.
    TRANSFERRED_OUT
    /// Пришёл переводом.
    TRANSFERRED_IN
    DISMISSED
    /// Закрыт вместе с группой: архивация или завершение.
    GROUP_CLOSED
    /// Запись удалена из группы.
    REMOVED
    LESSON_CANCELLED
    LESSON_RESTORED
    /// Состояние на момент запуска журнала: прошлое до него не восстановить.
    IMPORTED
}

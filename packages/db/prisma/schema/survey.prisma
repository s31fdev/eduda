/// Ответ на анонимную анкету со статической страницы (`eduda.online/pages/<имя>`).
///
/// Ни к школе, ни к ученику не привязан намеренно: анкета анонимная, и связать
/// ответ с человеком не должно быть нечем — ни имени, ни IP, ни сессии.
/// Ответы лежат одним JSON с кодами вариантов, а не колонками: вопросы меняются
/// от года к году, а `version` говорит, какой набор видел ребёнок.
model SurveyResponse {
    id              Int      @id @default(autoincrement())
    /// Ключ анкеты из `SURVEYS` (`apps/platform/src/features/surveys/registry.ts`).
    survey          String
    version         String
    answers         Json
    /// Сколько секунд заняло заполнение — по нему видно ответы «не читая».
    durationSeconds Int?
    createdAt       DateTime @default(now())

    @@index([survey, createdAt])
}
